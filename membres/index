    <style>
        :root {
            --primary: #0f4c75;
            --secondary: #3282b8;
            --accent: #bbe1fa;
            --bg: #f4f7f6;
            --text: #333;
            --muted: #64748b;
            --success: #16a34a;
            --warning: #f59e0b;
            --dark: #0f172a;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            background-color: var(--bg);
            color: var(--text);
            line-height: 1.6;
        }

        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            width: 100%;
            background: rgba(15, 76, 117, 0.96);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
        }

        .nav-container {
            max-width: 1200px;
            margin: auto;
            padding: 0.75rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: white;
            text-decoration: none;
            font-weight: 800;
            font-size: 1.1rem;
            letter-spacing: 0.3px;
        }

        .nav-brand img {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: white;
            object-fit: cover;
            box-shadow: 0 3px 10px rgba(0,0,0,0.22);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: #e0f2fe;
            text-decoration: none;
            font-size: 0.92rem;
            font-weight: 700;
            padding: 9px 13px;
            border-radius: 999px;
            transition: 0.25s ease;
        }

        .nav-links a:hover,
        .nav-links a.active {
            background: rgba(255, 255, 255, 0.16);
            color: white;
            transform: translateY(-1px);
        }

        .nav-links a.nav-highlight {
            background: linear-gradient(135deg, #16a34a, #2563eb);
            color: white;
            box-shadow: 0 6px 18px rgba(37, 99, 235, 0.25);
        }

        header {
            background:
                radial-gradient(circle at top left, rgba(187, 225, 250, 0.20), transparent 30%),
                radial-gradient(circle at bottom right, rgba(50, 130, 184, 0.22), transparent 35%),
                linear-gradient(135deg, #0f4c75, #1b262c);
            color: white;
            padding: 6rem 1rem 5.5rem;
            text-align: center;
        }

        .header-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 1rem;
            padding: 7px 14px;
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.22);
            border-radius: 999px;
            color: white;
            font-size: 0.9rem;
            font-weight: 800;
        }

        header h1 {
            margin: 0;
            font-size: clamp(2.5rem, 5vw, 4rem);
            font-weight: 900;
            letter-spacing: 0.5px;
        }

        header p {
            max-width: 820px;
            margin: 24px auto 0;
            color: #dbeafe;
            font-size: 1.08rem;
            line-height: 1.8;
        }

        .hero-actions {
            display: flex;
            justify-content: center;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .hero-btn {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            padding: 0.9rem 1.35rem;
            border-radius: 999px;
            text-decoration: none;
            font-weight: 900;
            transition: 0.25s ease;
        }

        .hero-btn.primary {
            background: linear-gradient(135deg, #16a34a, #2563eb);
            color: white;
            box-shadow: 0 8px 22px rgba(37, 99, 235, 0.25);
        }

        .hero-btn.secondary {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.28);
            color: white;
        }

        .hero-btn:hover {
            transform: translateY(-3px);
        }

        .container {
            max-width: 1120px;
            margin: auto;
            padding: 2.2rem;
        }

        section {
            margin-bottom: 3rem;
        }

        h2 {
            color: var(--primary);
            border-bottom: 3px solid var(--accent);
            display: inline-block;
            padding-bottom: 5px;
            margin-bottom: 1.5rem;
            font-size: 1.55rem;
        }

        .intro-card,
        .module-card,
        .vision-box {
            border: 1px solid rgba(15, 76, 117, 0.08);
            box-shadow: 0 10px 28px rgba(0,0,0,0.07);
        }

        .intro-card {
            background: white;
            border-radius: 20px;
            padding: 2rem;
        }

        .intro-card p {
            margin: 0;
            color: #475569;
            font-size: 1rem;
        }

        .rule-box {
            margin-top: 1.4rem;
            padding: 1rem 1.2rem;
            background: #f0fdf4;
            border-left: 5px solid var(--success);
            border-radius: 12px;
            color: #166534;
            font-weight: 750;
        }

        .module-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .module-card {
            position: relative;
            background: white;
            border-radius: 20px;
            padding: 1.6rem;
            transition: 0.25s ease;
            overflow: hidden;
        }

        .module-card.available:hover {
            transform: translateY(-5px);
            box-shadow: 0 16px 34px rgba(0,0,0,0.11);
        }

        .module-card i {
            font-size: 1.9rem;
            color: var(--secondary);
            margin-bottom: 12px;
        }

        .module-card h3 {
            margin: 0 0 8px;
            color: var(--primary);
            font-size: 1.18rem;
        }

        .module-card p {
            margin: 0 0 1.2rem;
            color: var(--muted);
            font-size: 0.95rem;
        }

        .module-link,
        .module-disabled {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 850;
            text-decoration: none;
        }

        .module-link {
            color: var(--primary);
        }

        .module-link:hover {
            color: var(--secondary);
        }

        .module-disabled {
            color: #94a3b8;
            cursor: not-allowed;
        }

        .status-badge {
            position: absolute;
            top: 1rem;
            right: 1rem;
            padding: 0.35rem 0.7rem;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 900;
        }

        .status-badge.open {
            background: #dcfce7;
            color: #166534;
        }

        .status-badge.soon {
            background: #fef3c7;
            color: #92400e;
        }

        .module-card.soon {
            background: #fbfdff;
        }

        .journey {
            display: grid;
            grid-template-columns: repeat(6, minmax(130px, 1fr));
            gap: 1rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .journey-step {
            min-width: 150px;
            padding: 1.2rem;
            background: white;
            border-radius: 18px;
            text-align: center;
            border: 1px solid rgba(15, 76, 117, 0.08);
            box-shadow: 0 8px 22px rgba(0,0,0,0.06);
        }

        .journey-step i {
            font-size: 1.55rem;
            color: var(--secondary);
            margin-bottom: 0.7rem;
        }

        .journey-step strong {
            display: block;
            color: var(--primary);
            margin-bottom: 0.35rem;
        }

        .journey-step span {
            color: var(--muted);
            font-size: 0.86rem;
        }

        .vision-box {
            background: linear-gradient(135deg, #0f4c75, #1b262c);
            color: white;
            border-radius: 22px;
            padding: 2.4rem;
            text-align: center;
        }

        .vision-box h2 {
            color: white;
            border-bottom-color: rgba(255,255,255,0.35);
            margin-top: 0;
        }

        .vision-box p {
            max-width: 820px;
            margin: 0 auto;
            color: #dbeafe;
        }

        .geomap-footer {
            margin-top: 4rem;
            background: #f7c65b;
            color: #003b7a;
            font-family: 'Segoe UI', sans-serif;
        }

        .footer-main {
            max-width: 1120px;
            margin: auto;
            padding: 3.6rem 2rem;
            display: grid;
            grid-template-columns: 1.35fr 1fr 1.35fr;
            gap: 2.5rem;
        }

        .footer-column {
            padding: 0 1.5rem;
        }

        .footer-column:not(:first-child) {
            border-left: 2px solid rgba(0, 59, 122, 0.35);
        }

        .footer-column h3 {
            margin: 0 0 1rem;
            color: #004aad;
            font-size: 1.5rem;
            font-weight: 900;
        }

        .footer-brand p {
            margin: 0;
            color: #003b7a;
            line-height: 1.8;
            font-size: 0.98rem;
        }

        .footer-menu {
            display: flex;
            flex-direction: column;
            gap: 0.55rem;
        }

        .footer-menu a {
            color: #003b7a;
            text-decoration: none;
            font-size: 1rem;
            transition: 0.25s ease;
        }

        .footer-menu a:hover {
            color: #004aad;
            transform: translateX(4px);
            font-weight: 700;
        }

        .social-icons {
            display: flex;
            gap: 0.9rem;
            flex-wrap: wrap;
        }

        .social-icons a,
        .copy-link-btn {
            width: 46px;
            height: 46px;
            background: #004aad;
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 1.25rem;
            transition: 0.25s ease;
            border: none;
            cursor: pointer;
            font-family: inherit;
        }

        .social-icons a:hover,
        .copy-link-btn:hover {
            background: #0f4c75;
            transform: translateY(-4px);
        }

        .share-note {
            margin: 1rem 0 0;
            color: #003b7a;
            font-size: 0.9rem;
        }

        .legal-section {
            max-width: 1120px;
            margin: auto;
            padding: 0 2rem 2rem;
        }

        .legal-section details {
            background: rgba(255, 255, 255, 0.38);
            border: 1px solid rgba(0, 59, 122, 0.22);
            border-radius: 14px;
            padding: 1rem 1.2rem;
        }

        .legal-section summary {
            cursor: pointer;
            color: #004aad;
            font-weight: 900;
            font-size: 1.05rem;
        }

        .legal-content {
            margin-top: 1rem;
            color: #003b7a;
            line-height: 1.7;
            font-size: 0.95rem;
        }

        .legal-content p {
            margin: 0 0 0.85rem;
        }

        .legal-content a {
            color: #004aad;
            font-weight: 800;
            text-decoration: none;
        }

        .footer-bottom {
            background: #0f4c75;
            color: #ffffff;
            padding: 1.2rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
        }

        .footer-bottom p {
            margin: 0;
            color: #ffffff;
            font-size: 0.95rem;
        }

        .footer-bottom a {
            color: #ffffff;
            text-decoration: none;
            font-weight: 700;
        }

        .footer-bottom span {
            margin: 0 0.5rem;
            opacity: 0.8;
        }

        .back-to-top {
            width: 48px;
            height: 48px;
            background: #f7c65b;
            color: #004aad !important;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none !important;
            font-size: 1.2rem;
            font-weight: 900;
            transition: 0.25s ease;
        }

        .back-to-top:hover {
            background: #ffd978;
            transform: translateY(-4px);
        }

        #geomap-loader {
            position: fixed;
            inset: 0;
            z-index: 99999;
            background:
                radial-gradient(circle at top left, rgba(187, 225, 250, 0.35), transparent 32%),
                radial-gradient(circle at bottom right, rgba(50, 130, 184, 0.18), transparent 35%),
                #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: opacity 0.8s ease, visibility 0.8s ease;
        }

        #geomap-loader.loader-hidden {
            opacity: 0;
            visibility: hidden;
        }

        .loader-content {
            text-align: center;
            animation: loaderFadeIn 0.8s ease forwards;
            padding: 2rem;
        }

        .loader-logo {
            width: 105px;
            height: 105px;
            border-radius: 50%;
            object-fit: cover;
            background: #ffffff;
            box-shadow: 0 12px 35px rgba(15, 76, 117, 0.28);
            animation: logoPulse 1.8s ease-in-out infinite;
        }

        .loader-title {
            margin-top: 18px;
            font-size: 1.35rem;
            font-weight: 900;
            color: #0f4c75;
            letter-spacing: 0.5px;
        }

        .loader-subtitle {
            margin-top: 6px;
            font-size: 0.92rem;
            color: #64748b;
        }

        .loader-spinner {
            width: 36px;
            height: 36px;
            border: 4px solid #dbeafe;
            border-top: 4px solid #0f4c75;
            border-radius: 50%;
            margin: 22px auto 0;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        @keyframes logoPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.07); }
        }

        @keyframes loaderFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @media (max-width: 800px) {
            .nav-container {
                flex-direction: column;
                align-items: center;
                padding: 0.9rem 1rem;
            }

            .nav-links {
                justify-content: center;
            }

            .nav-links a {
                font-size: 0.85rem;
                padding: 7px 10px;
            }

            header {
                padding: 5rem 1rem;
            }

            header h1 {
                font-size: 2.2rem;
            }

            header p {
                font-size: 0.98rem;
            }

            .container {
                padding: 1.2rem;
            }

            .intro-card,
            .vision-box {
                padding: 1.5rem;
            }

            .footer-main {
                grid-template-columns: 1fr;
                padding: 2.5rem 1.4rem;
                gap: 1.8rem;
            }

            .footer-column {
                padding: 0;
            }

            .footer-column:not(:first-child) {
                border-left: none;
                border-top: 2px solid rgba(0, 59, 122, 0.25);
                padding-top: 1.5rem;
            }

            .legal-section {
                padding: 0 1.4rem 1.8rem;
            }

            .footer-bottom {
                flex-direction: column;
                text-align: center;
            }

            .social-icons {
                justify-content: flex-start;
            }
        }
    </style>

