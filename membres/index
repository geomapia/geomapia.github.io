        const message = document.getElementById("copyMessage");

        if (navigator.clipboard) {
            navigator.clipboard.writeText(link).then(function () {
                message.textContent = "Lien copié : " + link;
            }).catch(function () {
                message.textContent = "Copiez ce lien : " + link;
            });
        } else {
            message.textContent = "Copiez ce lien : " + link;
        }
